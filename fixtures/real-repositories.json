{
  "repositories": [
    {
      "name": "express",
      "url": "https://github.com/expressjs/express",
      "commit": "a3714473feb3d2908add734d340e7755fd85e0a3",
      "minimumIndexedFiles": 140,
      "assertions": [
        {
          "command": "search",
          "query": "GET /middleware",
          "contains": [
            "examples/view-locals/index.js",
            "GET /middleware"
          ]
        },
        {
          "command": "callees",
          "query": "GET /middleware",
          "file": "examples/view-locals/index.js",
          "contains": [
            "\"name\": \"count\"",
            "\"name\": \"users\"",
            "\"provenance\": \"framework/express-route\""
          ]
        }
      ]
    },
    {
      "name": "lightrag",
      "url": "https://github.com/HKUDS/LightRAG",
      "commit": "44db36fe080645ba97ded719d44b42c7dee1f54a",
      "minimumIndexedFiles": 500,
      "assertions": [
        {
          "command": "search",
          "query": "GET /graph/label/list",
          "contains": [
            "lightrag/api/routers/graph_routes.py",
            "GET /graph/label/list"
          ]
        },
        {
          "command": "callers",
          "query": "LoginPage",
          "contains": [
            "ROUTE /login",
            "\"provenance\": \"framework/react-router\""
          ]
        }
      ]
    },
    {
      "name": "graphiti",
      "url": "https://github.com/getzep/graphiti",
      "commit": "526dcad7a300f3c5c506ff96a68bcdc7ca9f97ed",
      "minimumIndexedFiles": 250,
      "assertions": [
        {
          "command": "search",
          "query": "POST /search",
          "contains": [
            "server/graph_service/routers/retrieve.py",
            "POST /search"
          ]
        },
        {
          "command": "callers",
          "query": "search",
          "file": "server/graph_service/routers/retrieve.py",
          "contains": [
            "POST /search",
            "\"provenance\": \"framework/fastapi-route\""
          ]
        }
      ]
    },
    {
      "name": "django",
      "url": "https://github.com/django/django",
      "commit": "92470ad3742524902b29769d2c822dbe791630db",
      "minimumIndexedFiles": 2900,
      "assertions": [
        {
          "command": "search",
          "query": "ROUTE /regular/",
          "contains": [
            "tests/handlers/urls.py",
            "ROUTE /regular/"
          ]
        },
        {
          "command": "callees",
          "query": "ROUTE /regular/",
          "file": "tests/handlers/urls.py",
          "contains": [
            "\"name\": \"regular\"",
            "tests/handlers/views.py",
            "\"provenance\": \"framework/django-route\""
          ]
        }
      ]
    },
    {
      "name": "nest",
      "url": "https://github.com/nestjs/nest",
      "commit": "fafe503bd8ca073f2fdd41ed7138081af84c478e",
      "minimumIndexedFiles": 1700,
      "assertions": [
        {
          "command": "search",
          "query": "GET /users/:id",
          "contains": [
            "integration/repl/src/users/users.controller.ts",
            "GET /users/:id"
          ]
        },
        {
          "command": "callees",
          "query": "GET /users/:id",
          "file": "integration/repl/src/users/users.controller.ts",
          "contains": [
            "\"name\": \"findOne\"",
            "\"qualified_name\": \"UsersController.findOne\"",
            "\"provenance\": \"framework/nestjs-route\""
          ]
        }
      ]
    },
    {
      "name": "vue",
      "url": "https://github.com/vuejs/core",
      "commit": "b5f8518379b77c3b62a7a9d2b52f6c76cda09bd5",
      "minimumIndexedFiles": 530,
      "assertions": [
        {
          "command": "search",
          "query": "toggleProdMode",
          "contains": [
            "packages-private/sfc-playground/src/App.vue",
            "\"language\": \"vue\"",
            "\"start_line\": 88"
          ]
        },
        {
          "command": "callers",
          "query": "toggleProdMode",
          "file": "packages-private/sfc-playground/src/App.vue",
          "contains": [
            "\"kind\": \"component\"",
            "\"name\": \"App\"",
            "\"provenance\": \"framework/vue-template\"",
            "\"line\": 154"
          ]
        }
      ]
    },
    {
      "name": "svelte",
      "url": "https://github.com/sveltejs/svelte",
      "commit": "44a7813730579b94004e182e5a67aab27aa9d2a6",
      "minimumIndexedFiles": 7900,
      "assertions": [
        {
          "command": "search",
          "query": "handleKeydown",
          "contains": [
