            "\"language\": \"svelte\"",
            "\"start_line\": 2"
          ]
        },
        {
          "command": "callers",
          "query": "handleKeydown",
          "file": "packages/svelte/tests/print/samples/svelte-window/input.svelte",
          "contains": [
            "\"kind\": \"component\"",
            "\"provenance\": \"framework/svelte-template\"",
            "\"line\": 7"
          ]
        }
      ]
    }
  ]
}
